--==================================================
-- CHARACTER HELPERS
--==================================================

local function getPlayerCharacter()
    local character = LocalPlayer.Character
    if not character then
        return nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.RigType ~= Enum.HumanoidRigType.R15 then
        return nil
    end

    for _, partName in ipairs(BODY_PART_NAMES) do
        if not getfenv then
            -- No-op; keeps this script independent of environment APIs.
        end
    end

    local root = character:FindFirstChild("HumanoidRootPart")
    local head = character:FindFirstChild("Head")

    if not (
        root and root:IsA("BasePart")
        and head and head:IsA("BasePart")
    ) then
        return nil
    end

    return character, humanoid
end

function getBodyPart(model, name)
    if not model then
        return nil
    end

    local part = model:FindFirstChild(name, true)
    if part and part:IsA("BasePart") then
        return part
    end

    return nil
end

--==================================================
-- SCALE VALUES
--==================================================

local function captureScaleState(humanoid)
    local state = {
        AutomaticScalingEnabled = humanoid.AutomaticScalingEnabled,
        Values = {},
    }

    for name in pairs(SCALE_MAP) do
        local valueObject = humanoid:FindFirstChild(name)

        if valueObject and valueObject:IsA("NumberValue") then
            state.Values[name] = {
                Exists = true,
                Value = valueObject.Value,
            }
        else
            state.Values[name] = {
                Exists = false,
            }
        end
    end

    return state
end

local function restoreScaleState(humanoid, state)
    if not humanoid or not humanoid.Parent or not state then
        return
    end

    for name, saved in pairs(state.Values) do
        local current = humanoid:FindFirstChild(name)

        if saved.Exists then
            if not current or not current:IsA("NumberValue") then
                if current then
                    current:Destroy()
                end

                current = Instance.new("NumberValue")
                current.Name = name
                current.Parent = humanoid
            end

            current.Value = saved.Value
        elseif current and current:IsA("NumberValue") then
            current:Destroy()
        end
    end

    pcall(function()
        humanoid.AutomaticScalingEnabled =
            state.AutomaticScalingEnabled
    end)
end

local function applyScaleFromDescription(humanoid, description)
    humanoid.AutomaticScalingEnabled = true

    for scaleName, descriptionName in pairs(SCALE_MAP) do
        local scaleValue = tonumber(description[descriptionName])

        if scaleValue then
            local valueObject = humanoid:FindFirstChild(scaleName)

            if not valueObject or not valueObject:IsA("NumberValue") then
                if valueObject then
                    valueObject:Destroy()
                end

                valueObject = Instance.new("NumberValue")
                valueObject.Name = scaleName
                valueObject.Parent = humanoid
            end

            valueObject.Value = scaleValue
        end
    end
end

-- Keep movement-related settings unchanged across the scale operation.
local function captureMovementState(humanoid)
    return {
        WalkSpeed = humanoid.WalkSpeed,
        JumpPower = humanoid.JumpPower,
        JumpHeight = humanoid.JumpHeight,
        UseJumpPower = humanoid.UseJumpPower,
        AutoRotate = humanoid.AutoRotate,
    }
end

local function restoreMovementState(humanoid, state)
    if not humanoid or not humanoid.Parent or not state then
        return
    end

    pcall(function()
        humanoid.WalkSpeed = state.WalkSpeed
        humanoid.JumpPower = state.JumpPower
        humanoid.JumpHeight = state.JumpHeight
        humanoid.UseJumpPower = state.UseJumpPower
        humanoid.AutoRotate = state.AutoRotate
    end)
end

--==================================================
-- CLEANUP AND ORIGINAL VISIBILITY
--==================================================

local function restoreOriginalVisibility()
    for object, oldTransparency in pairs(hiddenOriginals) do
        if object and object.Parent then
            pcall(function()
                object.Transparency = oldTransparency
            end)
        end
    end

    table.clear(hiddenOriginals)
end

local function removePreviousOverlay()
    if activeOverlay then
        pcall(function()
            activeOverlay:Destroy()
        end)

        activeOverlay = nil
    end

    -- Also clean up an old overlay left by a previous execution.
    local character = LocalPlayer.Character
    if character then
        local oldOverlay = character:FindFirstChild(OVERLAY_NAME)
        if oldOverlay then
            oldOverlay:Destroy()
        end
    end

    restoreOriginalVisibility()
end

local function hideOriginalCharacter(character, overlay)
    for _, object in ipairs(character:GetDescendants()) do
        if not object:IsDescendantOf(overlay) then
            if object:IsA("BasePart")
                or object:IsA("Decal")
                or object:IsA("Texture") then

                if hiddenOriginals[object] == nil then
                    hiddenOriginals[object] = object.Transparency
                end

                -- Client-side transparency: hide old body and accessories.
                object.Transparency = 1
            end
        end
    end
end

--==================================================
-- ALIGN AND WELD
--==================================================

local function alignOverlayBodyParts(overlay, character)
    local matched = {}

    -- Align each overlay body part directly to the corresponding
    -- player body part's current pose. No player part is replaced,
    -- reparented, or removed.
    for _, partName in ipairs(BODY_PART_NAMES) do
        local playerPart = getBodyPart(character, partName)
        local overlayPart = getBodyPart(overlay, partName)

        if playerPart and overlayPart then
            overlayPart.CFrame = playerPart.CFrame

            table.insert(matched, {
                Name = partName,
                PlayerPart = playerPart,
                OverlayPart = overlayPart,
            })
        end
    end

    if #matched == 0 then
        error("No matching R15 body parts were found.")
    end

    if not getBodyPart(character, "HumanoidRootPart")
        or not getBodyPart(overlay, "HumanoidRootPart") then
        error("HumanoidRootPart is missing.")
    end

    return matched
end

local function weldOverlayToPlayer(matchedParts)
    local weldCount = 0

    -- FIRST: create every body weld.
    -- Part0 belongs to the player; Part1 belongs to the overlay.
    for _, pair in ipairs(matchedParts) do
        local playerPart = pair.PlayerPart
        local overlayPart = pair.OverlayPart

        local weld = Instance.new("Weld")
        weld.Name = "LocalAvatarWeld_" .. pair.Name
        weld.Part0 = playerPart
        weld.Part1 = overlayPart

        -- Preserve the exact relative pose at weld creation time.
        weld.C0 = playerPart.CFrame:ToObjectSpace(overlayPart.CFrame)
        weld.C1 = CFrame.new()

        weld.Parent = overlayPart
        weldCount += 1
    end

    -- SECOND: disable, but DO NOT destroy, the overlay's Motor6Ds.
    -- Player Motor6Ds remain untouched and control the animation.
    -- Do this after all body welds exist.
    local overlay = matchedParts[1].OverlayPart:FindFirstAncestor(OVERLAY_NAME)

    if overlay then
        for _, object in ipairs(overlay:GetDescendants()) do
            if object:IsA("Motor6D") then
                object.Enabled = false
            end
        end
    end

    -- THIRD: only now disable collision and touch/query on overlay parts.
    if overlay then
        for _, object in ipairs(overlay:GetDescendants()) do
            if object:IsA("BasePart") then
                object.CanCollide = false
                object.CanTouch = false
                object.CanQuery = false
                object.Massless = true
                object.Anchored = false
            end
        end
    end

    return weldCount
end

--==================================================
-- APPLY TARGET ANIMATION PACK
--==================================================

local ANIMATION_PROPERTIES = {
    idle = "IdleAnimation",
    walk = "WalkAnimation",
    run = "RunAnimation",
    jump = "JumpAnimation",
    fall = "FallAnimation",
    climb = "ClimbAnimation",
    swim = "SwimAnimation",
    swimidle = "SwimAnimation",
}

local function getAnimationCategory(animation, animateScript)
    local path = {}
    local node = animation.Parent

    while node and node ~= animateScript do
        table.insert(path, string.lower(node.Name))
        node = node.Parent
    end

    local joined = table.concat(path, " ")

    -- Check swimidle before idle/swim.
    if joined:find("swimidle", 1, true) then
        return "swimidle"
    elseif joined:find("idle", 1, true) then
        return "idle"
    elseif joined:find("walk", 1, true) then
        return "walk"
    elseif joined:find("run", 1, true) then
        return "run"
    elseif joined:find("jump", 1, true) then
        return "jump"
    elseif joined:find("fall", 1, true) then
        return "fall"
    elseif joined:find("climb", 1, true) then
        return "climb"
    elseif joined:find("swim", 1, true) then
        return "swim"
    end

    return nil
end

local function applyAnimationPack(character, humanoid, description)
    local animateScript = character:FindFirstChild("Animate")

    if not animateScript then
        return 0, "Animate script not found"
    end

    local changed = 0

    for _, object in ipairs(animateScript:GetDescendants()) do
        if object:IsA("Animation") then
            local category = getAnimationCategory(object, animateScript)
            local descriptionProperty =
                category and ANIMATION_PROPERTIES[category]

            if descriptionProperty then
                local animationAsset =
                    tonumber(description[descriptionProperty])

                if animationAsset and animationAsset > 0 then
                    object.AnimationId =
                        "rbxassetid://" .. tostring(math.floor(animationAsset))

                    changed += 1
                end
            end
        end
    end

    -- Stop currently playing tracks so the newly assigned IDs can take effect.
    local animator = humanoid:FindFirstChildOfClass("Animator")

    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            pcall(function()
                track:Stop(0.1)
            end)
        end
    end

    -- Restart the standard Animate LocalScript to reload animation IDs.
    if animateScript:IsA("LocalScript") or animateScript:IsA("Script") then
        pcall(function()
            animateScript.Enabled = false
        end)

        task.wait()

        if animateScript.Parent then
            pcall(function()
                animateScript.Enabled = true
            end)
        end
    end

    return changed, nil
end

--==================================================
-- APPLY AVATAR
--==================================================

local function applyAvatar(username)
    if applying then
        return
    end

    username = tostring(username or "")
        :gsub("^%s+", "")
        :gsub("%s+$", "")

    if username == "" then
        setStatus("Enter a username first.")
        return
    end

    applying = true
    applyButton.Text = "Loading..."
    setStatus("Loading avatar, scale and animations...")

    local sourceModel
    local sourceDescription

    local character
    local humanoid
    local previousScaleState
    local previousMovementState

    local scalesChanged = false
    local didHideOriginal = false

    local ok, err = pcall(function()
        character, humanoid = getPlayerCharacter()

        if not character or not humanoid then
            error("Your character must be R15 and fully loaded.")
        end

        previousScaleState = captureScaleState(humanoid)
        previousMovementState = captureMovementState(humanoid)

        local userId = Players:GetUserIdFromNameAsync(username)

        sourceDescription =
            Players:GetHumanoidDescriptionFromUserIdAsync(userId)

        if not sourceDescription then
            error("Could not load target avatar description.")
        end

        -- Create the complete target rig. Its body meshes, clothing
        -- and accessories remain in this separate model.
        sourceModel =
            Players:CreateHumanoidModelFromDescriptionAsync(
                sourceDescription,
                Enum.HumanoidRigType.R15
            )

        if not sourceModel then
            error("Could not create the target R15 rig.")
        end

        for _, partName in ipairs(BODY_PART_NAMES) do
            if not getBodyPart(sourceModel, partName) then
                error("Target rig is missing body part: " .. partName)
            end
        end

        -- Re-check in case the player respawned during loading.
        local currentCharacter, currentHumanoid = getPlayerCharacter()

        if currentCharacter ~= character or currentHumanoid ~= humanoid then
            error("Your character changed while the avatar was loading.")
        end

        -- Remove the previous overlay only after the new rig loaded.
        removePreviousOverlay()

        -- Apply target body proportions to the local R15 rig.
        -- Movement settings are restored immediately afterward.
        applyScaleFromDescription(humanoid, sourceDescription)
        scalesChanged = true

        RunService.Heartbeat:Wait()

        if not character.Parent or LocalPlayer.Character ~= character then
            error("Your character changed while applying scale.")
        end

        restoreMovementState(humanoid, previousMovementState)

        -- Disable the secondary Humanoid's state machine if supported.
        -- It should not independently control the overlay's movement.
        local overlayHumanoid = sourceModel:FindFirstChildOfClass("Humanoid")

        if overlayHumanoid then
            pcall(function()
                overlayHumanoid.EvaluateStateMachine = false
            end)

            pcall(function()
                overlayHumanoid.AutoRotate = false
            end)

            pcall(function()
                overlayHumanoid.WalkSpeed = 0
                overlayHumanoid.JumpPower = 0
                overlayHumanoid.JumpHeight = 0
            end)
        end

        -- Align matching parts to the player's CURRENT pose.
        -- This reduces the risk of applying during a walk cycle
        -- and locking a limb in the wrong initial offset.
        local matchedParts =
            alignOverlayBodyParts(sourceModel, character)

        -- Create the welds first. The helper then disables collisions
        -- only after all welds exist.
        sourceModel.Name = OVERLAY_NAME

        local weldCount = weldOverlayToPlayer(matchedParts)

        -- Parent the already-welded overlay into the character.
        sourceModel.Parent = character
        activeOverlay = sourceModel

        -- A second collision pass after parenting ensures all parts,
        -- including accessory handles, have local collision disabled.
        for _, object in ipairs(sourceModel:GetDescendants()) do
            if object:IsA("BasePart") then
                object.CanCollide = false
                object.CanTouch = false
                object.CanQuery = false
                object.Massless = true
                object.Anchored = false
            end
        end

        -- Hide the old player body and old accessories locally.
        hideOriginalCharacter(character, sourceModel)
        didHideOriginal = true

        -- Replace the IDs in the player's Animate script.
        local animationCount, animationMessage =
            applyAnimationPack(character, humanoid, sourceDescription)

        restoreMovementState(humanoid, previousMovementState)

        local message =
            "Welds: " .. weldCount
            .. " | Animations: " .. animationCount
            .. " | Scale applied"

        if animationMessage then
            message = message .. " | " .. animationMessage
        end

        setStatus(message)
    end)

    if not ok then
        -- Remove only the newly created overlay after an error.
        if sourceModel and sourceModel ~= activeOverlay then
            pcall(function()
                sourceModel:Destroy()
            end)
        elseif sourceModel and sourceModel == activeOverlay then
            pcall(function()
                sourceModel:Destroy()
            end)

            activeOverlay = nil
        end

        if didHideOriginal then
            restoreOriginalVisibility()
        end

        if scalesChanged and humanoid and previousScaleState then
            restoreScaleState(humanoid, previousScaleState)
        end

        if humanoid and previousMovementState then
            restoreMovementState(humanoid, previousMovementState)
        end

        setStatus("Error: " .. tostring(err))
    end

    if sourceDescription then
        pcall(function()
            sourceDescription:Destroy()
        end)
    end

    applying = false

    if applyButton and applyButton.Parent then
        applyButton.Text = "Apply Avatar"
    end
end

