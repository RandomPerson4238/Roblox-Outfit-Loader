-- R15 character helpers
local function inspectR15Model(model)
    if not model or not model:IsA("Model") then return nil end
    local hum = model:FindFirstChildOfClass("Humanoid")
    local head, upper, lower, root = model:FindFirstChild("Head",true), model:FindFirstChild("UpperTorso",true),
        model:FindFirstChild("LowerTorso",true), model:FindFirstChild("HumanoidRootPart",true)
    if not hum or hum.RigType ~= Enum.HumanoidRigType.R15 then return nil end
    if not (head and head:IsA("BasePart") and upper and upper:IsA("BasePart") and lower and lower:IsA("BasePart")
        and root and root:IsA("BasePart")) then return nil end
    return model, head, hum
end
local function getR15Character()
    local root = LocalPlayer.Character
    if not root then return nil end
    local hum = root:FindFirstChildOfClass("Humanoid")
    if hum and hum.RigType ~= Enum.HumanoidRigType.R15 then return nil end
    local model, head, foundHum = inspectR15Model(root)
    if model then return model, head, foundHum end
    for _, item in ipairs(root:GetDescendants()) do
        if item:IsA("Model") then
            model, head, foundHum = inspectR15Model(item)
            if model then return model, head, foundHum end
        end
    end
    return nil
end
local function getBodyPart(model, name)
    local part = model and model:FindFirstChild(name, true)
    return part and part:IsA("BasePart") and part or nil
end
local function getHandle(accessory)
    local h = accessory:FindFirstChild("Handle")
    return h and h:IsA("BasePart") and h or nil
end
local function findBodyAttachment(character, attachmentName)
    for _, name in ipairs(BODY_PART_NAMES) do
        local part = getBodyPart(character, name)
        if part then
            for _, obj in ipairs(part:GetDescendants()) do
                if obj:IsA("Attachment") and obj.Name == attachmentName then return obj, part end
            end
        end
    end
    return nil, nil
end

-- Layered clothing isn't rigidly weldable like classic accessories.
local layeredTypes = {}
for _, name in ipairs({"TShirt","Shirt","Pants","Jacket","Sweater","Shorts","LeftShoe","RightShoe","DressSkirt"}) do
    local ok, kind = pcall(function() return Enum.AccessoryType[name] end)
    if ok and kind then layeredTypes[kind] = true end
end
local function isLayeredClothing(accessory)
    local ok, kind = pcall(function() return accessory.AccessoryType end)
    return ok and layeredTypes[kind] == true
end

-- Capture an accessory's original source-rig binding before cloning it.
local function getOriginalBinding(sourceModel, accessory)
    local handle = getHandle(accessory)
    if not handle then return nil end
    for _, obj in ipairs(accessory:GetDescendants()) do
        if obj:IsA("JointInstance") then
            local p0, p1, other, handleWasPart0 = obj.Part0, obj.Part1, nil, false
            if p0 == handle and p1 ~= handle then other, handleWasPart0 = p1, true
            elseif p1 == handle and p0 ~= handle then other = p0 end
            if other and other:IsA("BasePart") and other:IsDescendantOf(sourceModel) and not other:IsDescendantOf(accessory) then
                return {kind="Joint", bodyName=other.Name, handleWasPart0=handleWasPart0, C0=obj.C0, C1=obj.C1,
                    relativeCFrame=other.CFrame:ToObjectSpace(handle.CFrame)}
            end
        elseif obj:IsA("WeldConstraint") then
            local p0, p1, other = obj.Part0, obj.Part1, nil
            if p0 == handle and p1 ~= handle then other = p1 elseif p1 == handle and p0 ~= handle then other = p0 end
            if other and other:IsA("BasePart") and other:IsDescendantOf(sourceModel) and not other:IsDescendantOf(accessory) then
                return {kind="Relative", bodyName=other.Name, relativeCFrame=other.CFrame:ToObjectSpace(handle.CFrame)}
            end
        end
    end
    return nil
end
local function findAttachmentBinding(accessory, character)
    local handle = getHandle(accessory)
    if not handle then return nil end
    for _, obj in ipairs(handle:GetDescendants()) do
        if obj:IsA("Attachment") then
            local targetAttachment, targetPart = findBodyAttachment(character, obj.Name)
            if targetAttachment and targetPart then
                return {kind="Attachment", bodyName=targetPart.Name, sourceAttachmentCFrame=obj.CFrame,
                    targetAttachmentCFrame=targetAttachment.CFrame}
            end
        end
    end
    return nil
end
local function findNearestBodyBinding(sourceModel, accessory)
    local handle = getHandle(accessory)
    if not handle then return nil end
    local nearest, minDistance = nil, math.huge
    for _, name in ipairs(BODY_PART_NAMES) do
        local part = getBodyPart(sourceModel, name)
        if part then
            local d = (part.Position - handle.Position).Magnitude
            if d < minDistance then nearest, minDistance = part, d end
        end
    end
    if not nearest then return nil end
    return {kind="Relative", bodyName=nearest.Name, relativeCFrame=nearest.CFrame:ToObjectSpace(handle.CFrame)}
end
local function prepareAccessoryClone(accessory)
    for _, obj in ipairs(accessory:GetDescendants()) do
        if obj:IsA("JointInstance") or obj:IsA("WeldConstraint") then obj:Destroy()
        elseif obj:IsA("BasePart") then
            obj.Anchored, obj.CanCollide, obj.CanTouch, obj.CanQuery, obj.Massless = false, false, false, false, true
        end
    end
end
local function weldAccessory(sourceModel, character, sourceAccessory)
    if isLayeredClothing(sourceAccessory) then return false, "Layered clothing skipped" end
    if not getHandle(sourceAccessory) then return false, "Accessory has no Handle" end
    local binding = getOriginalBinding(sourceModel, sourceAccessory)
    local targetPart = binding and getBodyPart(character, binding.bodyName)
    if not targetPart then
        binding = findAttachmentBinding(sourceAccessory, character)
        targetPart = binding and getBodyPart(character, binding.bodyName)
    end
    if not targetPart then
        binding = findNearestBodyBinding(sourceModel, sourceAccessory)
        targetPart = binding and getBodyPart(character, binding.bodyName)
    end
    if not targetPart or not binding then return false, "No R15 attachment target" end

    local ok, clone = pcall(function() return sourceAccessory:Clone() end)
    if not ok or not clone then return false, "Accessory clone failed" end
    local handle = getHandle(clone)
    if not handle then clone:Destroy(); return false, "Cloned accessory has no Handle" end
    prepareAccessoryClone(clone)
    clone.Parent = character
    local weld = Instance.new("Weld")
    weld.Name, weld.Part0, weld.Part1 = "R15AccessoryWeld", targetPart, handle
    if binding.kind == "Joint" then
        if binding.handleWasPart0 then weld.C0, weld.C1 = binding.C1, binding.C0
        else weld.C0, weld.C1 = binding.C0, binding.C1 end
    elseif binding.kind == "Attachment" then
        weld.C0, weld.C1 = binding.targetAttachmentCFrame, binding.sourceAttachmentCFrame
    else
        weld.C0, weld.C1 = binding.relativeCFrame, CFrame.new()
    end
    local positioned, err = pcall(function() handle.CFrame = targetPart.CFrame * weld.C0 * weld.C1:Inverse() end)
    if not positioned then clone:Destroy(); weld:Destroy(); return false, "Handle position failed: " .. tostring(err) end
    weld.Parent = handle
    return true
end

-- Copy source R15 mesh parts and attachments, then rewire the target rig's joints.
local function copyR15BodyGeometry(source, character)
    local partMap = {} -- old local body part -> cloned source body part
    for _, name in ipairs(BODY_PART_NAMES) do
        local sourcePart, oldPart = getBodyPart(source, name), getBodyPart(character, name)
        if sourcePart and oldPart then
            local ok, clone = pcall(function() return sourcePart:Clone() end)
            if ok and clone and clone:IsA("BasePart") then
                -- Cloned joints could still reference the temporary source model.
                for _, child in ipairs(clone:GetDescendants()) do
                    if child:IsA("JointInstance") or child:IsA("WeldConstraint") then child:Destroy() end
                end
                clone.Name, clone.CFrame = name, oldPart.CFrame
                clone.Anchored, clone.CanCollide = oldPart.Anchored, oldPart.CanCollide
                clone.CanTouch, clone.CanQuery, clone.Massless = oldPart.CanTouch, oldPart.CanQuery, oldPart.Massless
                clone.Parent = oldPart.Parent
                partMap[oldPart] = clone
            elseif clone then
                clone:Destroy()
            end
        end
    end

    local sourceMotors = {}
    for _, obj in ipairs(source:GetDescendants()) do
        if obj:IsA("Motor6D") then sourceMotors[obj.Name] = obj end
    end

    -- Repoint the existing joints before removing the original parts.
    for _, joint in ipairs(character:GetDescendants()) do
        if joint:IsA("JointInstance") then
            local newParent = partMap[joint.Parent]
            if newParent then joint.Parent = newParent end
            if joint.Part0 and partMap[joint.Part0] then joint.Part0 = partMap[joint.Part0] end
            if joint.Part1 and partMap[joint.Part1] then joint.Part1 = partMap[joint.Part1] end
            if joint:IsA("Motor6D") then
                local sourceMotor = sourceMotors[joint.Name]
                if sourceMotor then
                    pcall(function() joint.C0, joint.C1 = sourceMotor.C0, sourceMotor.C1 end)
                end
            end
        elseif joint:IsA("WeldConstraint") then
            if joint.Part0 and partMap[joint.Part0] then joint.Part0 = partMap[joint.Part0] end
            if joint.Part1 and partMap[joint.Part1] then joint.Part1 = partMap[joint.Part1] end
        end
    end

    for oldPart in pairs(partMap) do
        if oldPart and oldPart.Parent then oldPart:Destroy() end
    end

    -- Mesh geometry comes from each cloned source part; match its visible surface settings too.
    for _, name in ipairs(BODY_PART_NAMES) do
        local src, target = getBodyPart(source, name), getBodyPart(character, name)
        if src and target then
            pcall(function()
                target.Color, target.Transparency, target.Reflectance = src.Color, src.Transparency, src.Reflectance
            end)
        end
    end
    return #BODY_PART_NAMES
end

local function copyR15Appearance(source, character)
    local copied, skipped = 0, 0
    for _, obj in ipairs(character:GetChildren()) do
        if obj:IsA("Accessory") then obj:Destroy()
        elseif obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("ShirtGraphic") or obj:IsA("BodyColors") then obj:Destroy() end
    end

    local partCount = copyR15BodyGeometry(source, character)

    -- Classic clothing and BodyColors. Layered clothing is handled separately and skipped.
    for _, obj in ipairs(source:GetDescendants()) do
        if obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("ShirtGraphic") or obj:IsA("BodyColors") then
            local ok, clone = pcall(function() return obj:Clone() end)
            if ok and clone then clone.Parent = character; copied += 1 else skipped += 1 end
        end
    end

    for _, obj in ipairs(source:GetDescendants()) do
        if obj:IsA("Accessory") then
            local parent, nested = obj.Parent, false
            while parent and parent ~= source do
                if parent:IsA("Accessory") then nested = true; break end
                parent = parent.Parent
            end
            if not nested then
                if isLayeredClothing(obj) then
                    skipped += 1
                else
                    local ok, result = pcall(function() return weldAccessory(source, character, obj) end)
                    if ok and result == true then copied += 1 else skipped += 1 end
                end
            end
        end
    end
    return copied, skipped, partCount
end

-- Apply avatar appearance locally.
local function applyAvatar(username)
    if applying then return end
    username = tostring(username or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if username == "" then setStatus("Enter a username first."); return end
    applying = true
    applyButton.Text = "Loading..."
    setStatus("Loading R15 avatar...")
    local sourceModel, sourceDescription

    local ok, err = pcall(function()
        if not getR15Character() then error("Your character must be R15 and fully loaded.") end
        local userId = Players:GetUserIdFromNameAsync(username)
        sourceDescription = Players:GetHumanoidDescriptionFromUserIdAsync(userId)
        if not sourceDescription then error("Could not load target avatar description.") end
        sourceModel = Players:CreateHumanoidModelFromDescriptionAsync(sourceDescription, Enum.HumanoidRigType.R15)
        if not sourceModel then error("Could not create source R15 model.") end
        local sourceHumanoid = sourceModel:FindFirstChildOfClass("Humanoid")
        if not sourceHumanoid or sourceHumanoid.RigType ~= Enum.HumanoidRigType.R15 then
            error("Source model is not R15; current appearance was not changed.")
        end
        for _, name in ipairs(BODY_PART_NAMES) do
            if not getBodyPart(sourceModel, name) then error("Source R15 model is missing body part: " .. name) end
        end
        -- Re-resolve after the avatar API calls in case the player respawned.
        local character = getR15Character()
        if not character then error("Your R15 character is no longer available.") end
        local copied, skipped, partCount = copyR15Appearance(sourceModel, character)
        setStatus("Copied " .. copied .. " | Skipped " .. skipped .. " | R15 parts: " .. partCount)
    end)

    if sourceModel then pcall(function() sourceModel:Destroy() end) end
    if sourceDescription then pcall(function() sourceDescription:Destroy() end) end
    if not ok then setStatus("Error: " .. tostring(err)) end
    applying = false
    if applyButton and applyButton.Parent then applyButton.Text = "Apply Avatar" end
end

applyButton.MouseButton1Click:Connect(function()
    lastUsername = input.Text
    applyAvatar(lastUsername)
