    BodyHeightScale = "HeightScale",
    BodyWidthScale = "WidthScale",
    BodyDepthScale = "DepthScale",
    HeadScale = "HeadScale",
    BodyTypeScale = "BodyTypeScale",
    BodyProportionScale = "ProportionScale",
}

