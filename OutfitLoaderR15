-- HELPERS
--==================================================
local function getBodyPart(model, name)
    if not model then return nil end
    local part = model:FindFirstChild(name, true)
    if part and part:IsA("BasePart") then return part end
    return nil
end

local function getPlayerCharacter()
    local character = LocalPlayer.Character
    if not character then return nil end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.RigType ~= Enum.HumanoidRigType.R15 then return nil end
    local root = getBodyPart(character, "HumanoidRootPart")
    local head = getBodyPart(character, "Head")
    if not root or not head then return nil end
    return character, humanoid
end

local function applyScaleFromDescription(humanoid, description)
    humanoid.AutomaticScalingEnabled = true
    for scaleName, descriptionName in pairs(SCALE_MAP) do
        local targetValue = tonumber(description[descriptionName])
        if targetValue then
            local value = humanoid:FindFirstChild(scaleName)
            if not value or not value:IsA("NumberValue") then
                if value then value:Destroy() end
                value = Instance.new("NumberValue")
                value.Name = scaleName
                value.Parent = humanoid
            end
            value.Value = targetValue
        end
    end
end

local function restoreOriginalVisibility()
    for object, oldTransparency in pairs(hiddenOriginals) do
        if object and object.Parent then
            pcall(function() object.Transparency = oldTransparency end)
        end
    end
    table.clear(hiddenOriginals)
end

local function cleanupAnimationController(restoreAnimate)
    local controller = activeAnimationController
    if not controller then return end
    for _, connection in ipairs(controller.Connections) do pcall(function() connection:Disconnect() end) end
    for _, track in pairs(controller.Tracks) do pcall(function() track:Stop(0.1) track:Destroy() end) end
    for _, animation in ipairs(controller.Animations) do pcall(function() animation:Destroy() end) end
    if restoreAnimate and controller.AnimateScript and controller.AnimateScript.Parent then
        pcall(function() controller.AnimateScript.Enabled = controller.AnimateWasEnabled end)
    end
    activeAnimationController = nil
end

local function removePreviousOverlay()
    cleanupAnimationController(true)
    if activeOverlay then
        pcall(function() activeOverlay:Destroy() end)
        activeOverlay = nil
    end
    if activeMotorSync then
        activeMotorSync:Disconnect()
        activeMotorSync = nil
    end
    restoreOriginalVisibility()
end

local function hideOriginalCharacter(character, overlay)
    for _, object in ipairs(character:GetDescendants()) do
        if not object:IsDescendantOf(overlay) then
            if object:IsA("BasePart") or object:IsA("Decal") or object:IsA("Texture") then
                if object.Name ~= "HumanoidRootPart" then
                    if hiddenOriginals[object] == nil then hiddenOriginals[object] = object.Transparency end
                    object.Transparency = 1
                end
            end
        end
    end
end

local function resolveRealAnimationId(catalogId)
    local numId = tonumber(tostring(catalogId):match("%d+"))
    if not numId or numId <= 0 then return nil end
    if ResolvedAnimationCache[numId] then return ResolvedAnimationCache[numId] end

    local realId = nil
    pcall(function()
        local objects = game:GetObjects("rbxassetid://" .. tostring(numId))
        if objects and objects[1] then
            local animObj = objects[1]:FindFirstChildWhichIsA("Animation", true)
            if animObj and animObj.AnimationId then
                realId = animObj.AnimationId:match("%d+")
            end
            -- ĐỂ NGUYÊN không gọi Destroy() để Executor không bị hỏng bộ nhớ đệm
        end
    end)

    realId = realId or tostring(numId)
    ResolvedAnimationCache[numId] = realId
    return realId
end

--==================================================
-- ANIMATION CONTROLLER
--==================================================
local function createAnimationController(character, humanoid, description, freezeState)
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end

    local tracks = {}
    local animationObjects = {}
    local connections = {}

    local controller = {
        Tracks = tracks, Animations = animationObjects, Connections = connections,
        AnimateScript = freezeState.AnimateScript, AnimateWasEnabled = freezeState.AnimateWasEnabled, Humanoid = humanoid,
    }

    local priorities = {
        idle = Enum.AnimationPriority.Idle, walk = Enum.AnimationPriority.Movement,
        run = Enum.AnimationPriority.Movement, jump = Enum.AnimationPriority.Action,
        fall = Enum.AnimationPriority.Action, climb = Enum.AnimationPriority.Action, swim = Enum.AnimationPriority.Action,
    }

    local loadedCount = 0

    local function loadTrack(key, propertyName)
        local rawProp = description[propertyName]
        local realAnimId = resolveRealAnimationId(rawProp)
        if not realAnimId then return end

        local animation = Instance.new("Animation")
        animation.Name = "LocalAvatar_" .. key
        animation.AnimationId = "rbxassetid://" .. realAnimId
        animation.Parent = character

        table.insert(animationObjects, animation)
        local ok, track = pcall(function() return animator:LoadAnimation(animation) end)
        if not ok or not track then return end

        track.Priority = priorities[key] or Enum.AnimationPriority.Movement
        track.Looped = key ~= "jump"
        tracks[key] = track
        loadedCount += 1
    end

    for key, propertyName in pairs(ANIMATION_PROPERTIES) do loadTrack(key, propertyName) end

    -- Nếu user không xài Animation Pack, trả về xài Animation mặc định
    if loadedCount == 0 then
        for _, animation in ipairs(animationObjects) do pcall(function() animation:Destroy() end) end
        if freezeState.AnimateScript and freezeState.AnimateScript.Parent and freezeState.AnimateWasEnabled ~= nil then
            freezeState.AnimateScript.Enabled = freezeState.AnimateWasEnabled
        end
        return nil, 0
    end

    activeAnimationController = controller
    local currentKey = nil
    local specialState = nil
    local lastSpeed = 0

    local function stopOtherTracks(exceptKey)
        for key, track in pairs(tracks) do
            if key ~= exceptKey and track.IsPlaying then pcall(function() track:Stop(0.12) end) end
        end
    end

    local function play(key, speed)
        local track = tracks[key]
        if not track and key == "run" then track = tracks.walk; key = track and "walk" or key end
        if not track and key == "walk" then track = tracks.run; key = track and "run" or key end
        if not track and (key == "jump" or key == "fall") then track = tracks.idle or tracks.walk or tracks.run end
        if not track and key == "swim" then track = tracks.walk or tracks.idle end
        if not track and key == "climb" then track = tracks.walk or tracks.idle end
        if not track then return end

        if currentKey == key and track.IsPlaying then
            if (key == "walk" or key == "run") and speed then pcall(function() track:AdjustSpeed(math.clamp(speed / 16, 0.65, 1.6)) end) end
            return
        end

        stopOtherTracks(key)
        currentKey = key
        if not track.IsPlaying then
            local ok = pcall(function() track:Play(0.12, 1, 1) end)
            if not ok then currentKey = nil; return end
        end
        if (key == "walk" or key == "run") and speed then pcall(function() track:AdjustSpeed(math.clamp(speed / 16, 0.65, 1.6)) end) end
    end

    local function playLocomotion(speed)
        lastSpeed = speed or lastSpeed
        if lastSpeed > 0.5 then
            local walkSpeed = math.max(humanoid.WalkSpeed, 1)
            if lastSpeed < walkSpeed * 0.8 then play("walk", lastSpeed) else play("run", lastSpeed) end
        else
            play("idle")
        end
    end

    table.insert(connections, humanoid.Running:Connect(function(speed)
        lastSpeed = speed
        if not specialState then playLocomotion(speed) end
    end))

    table.insert(connections, humanoid.StateChanged:Connect(function(_, newState)
        if newState == Enum.HumanoidStateType.Jumping then specialState = "jump"; play("jump")
        elseif newState == Enum.HumanoidStateType.Freefall then specialState = "fall"; play("fall")
        elseif newState == Enum.HumanoidStateType.Climbing then specialState = "climb"; play("climb")
        elseif newState == Enum.HumanoidStateType.Swimming then specialState = "swim"; play("swim")
        elseif newState == Enum.HumanoidStateType.Seated then specialState = "seated"; stopOtherTracks(nil); currentKey = nil
        elseif newState == Enum.HumanoidStateType.Dead then
            specialState = "dead"
            for _, track in pairs(tracks) do pcall(function() track:Stop(0.1) end) end
            currentKey = nil
        elseif newState == Enum.HumanoidStateType.Landed or newState == Enum.HumanoidStateType.Running or newState == Enum.HumanoidStateType.RunningNoPhysics or newState == Enum.HumanoidStateType.GettingUp then
            specialState = nil; playLocomotion(lastSpeed)
        end
    end))

    playLocomotion(0)
    return controller, loadedCount
end

