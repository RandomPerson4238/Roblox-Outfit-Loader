--==================================================
-- CHARACTER HELPERS
--==================================================

local function getPlayerCharacter()
    local character = LocalPlayer.Character
    if not character then
        return nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not humanoid or humanoid.RigType ~= Enum.HumanoidRigType.R15 then
        return nil
    end

    local root = character:FindFirstChild("HumanoidRootPart")
    local head = character:FindFirstChild("Head")

    if not (
        root and root:IsA("BasePart")
        and head and head:IsA("BasePart")
    ) then
        return nil
    end

    return character, humanoid
end

local function getBodyPart(model, name)
    if not model then
        return nil
    end

    local part = model:FindFirstChild(name, true)

    if part and part:IsA("BasePart") then
        return part
    end

    return nil
end

--==================================================
-- RESTORE / HIDE PLAYER VISUALS
--==================================================

local function restoreOriginalVisibility()
    for object, oldTransparency in pairs(hiddenOriginals) do
        if object and object.Parent then
            pcall(function()
                object.Transparency = oldTransparency
            end)
        end
    end

    table.clear(hiddenOriginals)
end

local function removePreviousOverlay()
    if activeOverlay then
        pcall(function()
            activeOverlay:Destroy()
        end)

        activeOverlay = nil
    end

    restoreOriginalVisibility()
end

local function hideOriginalCharacter(character, overlay)
    for _, object in ipairs(character:GetDescendants()) do
        -- Never hide anything belonging to the newly-added avatar.
        if not object:IsDescendantOf(overlay) then
            if object:IsA("BasePart")
                or object:IsA("Decal")
                or object:IsA("Texture") then

                if hiddenOriginals[object] == nil then
                    hiddenOriginals[object] = object.Transparency
                end

                -- Global transparency change, as requested.
                object.Transparency = 1
            end
        end
    end
end

--==================================================
-- ALIGN THE OVERLAY MODEL
--==================================================

local function alignOverlayRoot(overlay, playerRoot)
    local overlayRoot = getBodyPart(overlay, "HumanoidRootPart")

    if not overlayRoot then
        error("Target avatar is missing HumanoidRootPart.")
    end

    -- Move the complete overlay model so the two root parts start aligned.
    -- No parts are transferred into or substituted for the player's rig.
    local offset = playerRoot.CFrame * overlayRoot.CFrame:Inverse()
    overlay:PivotTo(offset * overlay:GetPivot())
end

--==================================================
-- WELD OVERLAY -> PLAYER
--==================================================

local function weldOverlayToPlayer(overlay, playerCharacter)
    local partsToWeld = {}

    -- Gather all matching parts before creating any weld.
    for _, partName in ipairs(BODY_PART_NAMES) do
        local playerPart = getBodyPart(playerCharacter, partName)
        local overlayPart = getBodyPart(overlay, partName)

        if playerPart and overlayPart then
            table.insert(partsToWeld, {
                Name = partName,
                PlayerPart = playerPart,
                OverlayPart = overlayPart,
            })
        end
    end

    if #partsToWeld == 0 then
        error("No matching R15 parts found to weld.")
    end

    -- STEP 1: CREATE ALL BODY WELDS FIRST.
    -- Part0 = player's original part.
    -- Part1 = matching part on the added avatar.
    -- Motor6Ds in BOTH rigs are left untouched and enabled.
    local weldCount = 0

    for _, pair in ipairs(partsToWeld) do
        local playerPart = pair.PlayerPart
        local overlayPart = pair.OverlayPart

        local weld = Instance.new("Weld")
        weld.Name = "LocalAvatarWeld_" .. pair.Name

        weld.Part0 = playerPart
        weld.Part1 = overlayPart

        -- Keep the overlay part's current relative offset.
        weld.C0 = playerPart.CFrame:ToObjectSpace(overlayPart.CFrame)
        weld.C1 = CFrame.new()

        weld.Parent = overlayPart

        weldCount += 1
    end

    -- STEP 2: ONLY AFTER ALL WELDS EXIST, DISABLE COLLISION.
    for _, object in ipairs(overlay:GetDescendants()) do
        if object:IsA("BasePart") then
            object.Anchored = false
            object.CanCollide = false
            object.CanTouch = false
            object.CanQuery = false
            object.Massless = true
        end
    end

    return weldCount, #partsToWeld
end

--==================================================
-- APPLY AVATAR
--==================================================

local function applyAvatar(username)
    if applying then
        return
    end

    username = tostring(username or "")
        :gsub("^%s+", "")
        :gsub("%s+$", "")

    if username == "" then
        setStatus("Enter a username first.")
        return
    end

    applying = true
    applyButton.Text = "Loading..."
    setStatus("Loading R15 avatar...")

    local sourceModel
    local sourceDescription

    local ok, err = pcall(function()
        local currentCharacter = getPlayerCharacter()

        if not currentCharacter then
            error("Your character must be R15 and fully loaded.")
        end

        -- Resolve username and obtain the avatar description.
        local userId = Players:GetUserIdFromNameAsync(username)

        sourceDescription =
            Players:GetHumanoidDescriptionFromUserIdAsync(userId)

        if not sourceDescription then
            error("Could not load the target avatar description.")
        end

        -- Create a complete separate R15 rig with its avatar appearance.
        sourceModel =
            Players:CreateHumanoidModelFromDescriptionAsync(
                sourceDescription,
                Enum.HumanoidRigType.R15
            )

        if not sourceModel then
            error("Could not create the target R15 model.")
        end

        local sourceHumanoid =
            sourceModel:FindFirstChildOfClass("Humanoid")

        if not sourceHumanoid
            or sourceHumanoid.RigType ~= Enum.HumanoidRigType.R15 then
            error("The target model is not an R15 rig.")
        end

        for _, partName in ipairs(BODY_PART_NAMES) do
            if not getBodyPart(sourceModel, partName) then
                error("Missing target body part: " .. partName)
            end
        end

        -- Resolve the character again after avatar API calls.
        local character = getPlayerCharacter()

        if not character then
            error("Your R15 character is no longer available.")
        end

        local playerRoot = getBodyPart(character, "HumanoidRootPart")

        if not playerRoot then
            error("Your character is missing HumanoidRootPart.")
        end

        -- Remove the previous overlay and restore the original visibility.
        removePreviousOverlay()

        -- Parent the independent rig under the player's character.
        sourceModel.Name = OVERLAY_NAME

        -- Align the complete model by its root; don't replace any player parts.
        alignOverlayRoot(sourceModel, playerRoot)
        sourceModel.Parent = character

        -- Weld first, then switch off collisions.
        local welded, available =
            weldOverlayToPlayer(sourceModel, character)

        activeOverlay = sourceModel

        -- Finally, hide the player's original parts and old accessories.
        hideOriginalCharacter(character, sourceModel)

        setStatus(
            "Welded " .. welded .. "/" .. available
            .. " R15 parts. Original player rig kept."
        )
    end)

    if sourceDescription then
        pcall(function()
            sourceDescription:Destroy()
        end)
    end

    if not ok then
        if sourceModel and sourceModel ~= activeOverlay then
            pcall(function()
                sourceModel:Destroy()
            end)
        end

        setStatus("Error: " .. tostring(err))
    end

    applying = false

    if applyButton and applyButton.Parent then
        applyButton.Text = "Apply Avatar"
    end
end

