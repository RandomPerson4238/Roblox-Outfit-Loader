    applyOnRespawn = not applyOnRespawn
    lastUsername = input.Text

    updateRespawnButton()

    setStatus(
        applyOnRespawn
            and "Respawn apply enabled."
            or "Respawn apply disabled."
    )
end)

if respawnConnection then
    respawnConnection:Disconnect()
end

respawnConnection = LocalPlayer.CharacterAdded:Connect(function()
    -- The previous character and overlay are gone after respawn.
    activeOverlay = nil
    table.clear(hiddenOriginals)

    if applyOnRespawn and lastUsername ~= "" then
        task.wait(2)
        applyAvatar(lastUsername)
    end
end)

