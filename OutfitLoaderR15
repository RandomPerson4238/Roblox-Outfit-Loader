    "HumanoidRootPart",
    "Head",
    "UpperTorso",
    "LowerTorso",

    "LeftUpperArm",
    "LeftLowerArm",
    "LeftHand",

    "RightUpperArm",
    "RightLowerArm",
    "RightHand",

    "LeftUpperLeg",
    "LeftLowerLeg",
    "LeftFoot",

    "RightUpperLeg",
    "RightLowerLeg",
    "RightFoot",
}

